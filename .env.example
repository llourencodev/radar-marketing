# Copie este arquivo para ".env" e ajuste o que quiser. Tudo e opcional.

# Servidor local
RADAR_HOST=127.0.0.1
RADAR_PORT=8765

# Coleta automatica: intervalo padrao (minutos) para fontes sem intervalo proprio
COLLECT_INTERVAL_MIN=60
# 0 desliga a busca da imagem (og:image) na pagina da noticia
FETCH_PAGE_IMAGE=1

# IA opcional: none (padrao, so regras locais) | claude | ollama
LLM_PROVIDER=none
# Maximo de noticias enviadas ao LLM por ciclo de coleta
LLM_MAX_PER_RUN=25

# Claude (Anthropic): defina a chave aqui. O modelo pode ser trocado por um
# mais barato para resumos em volume, por exemplo claude-haiku-5-5.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ollama local (gratuito)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
